# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_discord_server_id

# Channel IDs (Right-click channel in Discord -> Copy ID)
# NOTE: Most commands use channel NAMES (e.g., "idle-mining") via require_channel decorator
# These IDs are only needed for specific features that require direct channel references
COUNCIL_CHAMBERS_CHANNEL_ID=123456789
OFF_TOPIC_CHANNEL_ID=123456789
KINGDOM_HERALD_CHANNEL_ID=123456789
QUEST_LOG_CHANNEL_ID=123456789
HEARTH_CHANNEL_ID=123456789
WHISPERS_CHANNEL_ID=123456789

# Idle & Utility Channels
SLAYER_CHANNEL_ID=123456789
HUNTING_CHANNEL_ID=123456789
MINING_CHANNEL_ID=123456789
FISHING_CHANNEL_ID=123456789
WOODCUTTING_CHANNEL_ID=123456789
COOKING_CHANNEL_ID=123456789
CRAFTING_CHANNEL_ID=123456789
SMITHING_CHANNEL_ID=123456789
FORGE_CHANNEL_ID=123456789
SHOP_CHANNEL_ID=123456789

# Admin Channel (for global skip mode in owner commands)
# When !owner skip is run from this channel, it affects ALL active tasks globally
# instead of just the current channel's task
OWNER_CHANNEL_ID=123456789

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=sparksammy/samantha-uncensored-v5:gpt-oss-20b
# Optional: override the model used for DM/narrator generation (defaults to DEFAULT_MODEL)
# DM_MODEL=sparksammy/samantha-uncensored-v5:gpt-oss-20b
TEMPERATURE=0.7

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
